#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopVK
/config:
/profile:HiDef
/compress:False

#-------------------------------- References --------------------------------#

# The SM 6 effect processor of the MonoGame fork (monogame/pipeline, SpirvEffectProcessor: DXC to SPIR-V for Vulkan),
# built before the content by the client's project reference into a fixed folder.
/reference:../../../monogame/pipeline/bin/MonoGame.Effect.Processor.dll


#---------------------------------- Content ---------------------------------#

# The SM 6.0 shader library (Shaders/, see docs/shaders.md), compiled for Vulkan (vs_6_0/ps_6_0). Surface.fx is built for
# the static and the skinned vertex factories (SKINNED); each effect selects its pass by technique.
#begin Shaders/Passes/Surface.fx
/importer:EffectImporter
/processor:SpirvEffectProcessor
/processorParam:DebugMode=Auto
/build:Shaders/Passes/Surface.fx;Effects/StaticSurface.fx

#begin Shaders/Passes/Surface.fx
/importer:EffectImporter
/processor:SpirvEffectProcessor
/processorParam:DebugMode=Auto
/processorParam:Defines=SKINNED
/build:Shaders/Passes/Surface.fx;Effects/SkinnedSurface.fx

#begin Shaders/Passes/Unlit.fx
/importer:EffectImporter
/processor:SpirvEffectProcessor
/processorParam:DebugMode=Auto
/build:Shaders/Passes/Unlit.fx;Effects/Unlit.fx

#begin Shaders/Passes/Vfx.fx
/importer:EffectImporter
/processor:SpirvEffectProcessor
/processorParam:DebugMode=Auto
/build:Shaders/Passes/Vfx.fx;Effects/Vfx.fx

#begin Shaders/Passes/Rain.fx
/importer:EffectImporter
/processor:SpirvEffectProcessor
/processorParam:DebugMode=Auto
/build:Shaders/Passes/Rain.fx;Effects/Rain.fx

